# Postgres. Use a Neon pooled connection string on Vercel.
DATABASE_URL=postgres://applykar:applykar@127.0.0.1:5432/applykar

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:4317

# Google OAuth client. Authorized redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google accounts that may sign in. Everyone else is rejected.
ALLOWED_EMAILS=you@gmail.com

# How many job-search profiles the owner can keep.
MAX_PROFILES=5

# Bearer token for the MCP server at /api/mcp
MCP_BEARER_TOKEN=

# Sent by Vercel Cron as Authorization: Bearer
CRON_SECRET=

# Optional rules-gap enrichment and embeddings. LLM runs only when LLM_ENRICH=true.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_ENRICH=false

# Apply worker. Runs locally, not on Vercel. Set APPLY_SUBMIT=0 to fill forms without submitting.
APPLY_SUBMIT=1
APPLY_CONCURRENCY=3

# Inbox. Each profile address is {slug}@INBOX_DOMAIN. Webhook: POST /api/inbox/webhook
INBOX_DOMAIN=
INBOX_WEBHOOK_SECRET=
INBOX_IMAP_HOST=
INBOX_IMAP_PORT=993
INBOX_IMAP_USER=
INBOX_IMAP_PASSWORD=
INBOX_IMAP_TLS=true

# Gmail connect uses the same Google client, with redirect {AUTH_URL}/api/auth/callback/gmail
# and the gmail.readonly scope.

# Optional extra sources. Left blank, they stay off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_QUERY=software engineer
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=applykar@example.com
USAJOBS_QUERY=software engineer
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_QUERY=software engineer in united states
